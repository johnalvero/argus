# Argus — environment

# Path to the SQLite file. Prisma resolves relative paths from the
# schema file, so `file:./dev.db` lives at prisma/dev.db.
DATABASE_URL="file:./dev.db"

# 64-byte hex secret used to sign session JWTs (HS256).
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace-me-with-a-real-64-byte-hex-value"

# Optional: encryption key for at-rest secrets (SES credentials, etc.).
# Must be >= 32 chars. If unset, a key is auto-generated on first run
# and persisted to prisma/.encryption-key (mode 0600). Either way, BACK
# UP whichever source you choose alongside the SQLite database — losing
# the key makes stored SES credentials unrecoverable.
# ENCRYPTION_KEY="replace-with-32+-random-chars"

# Set to 1 in local dev if you want to use the cookie over plain http.
# Production defaults to secure cookies via NODE_ENV.
INSECURE_COOKIES=1

# When the app sits behind a proxy you actually control (ALB / nginx),
# set this so client IPs are sourced from X-Forwarded-For for rate-limiting.
# TRUST_PROXY=true
